---
import Newsletter from './Newsletter.astro';
import { t, type Locale } from '../lib/i18n';

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const copy = t(lang).footer;
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="container">
		<hr class="hairline" />
		<Newsletter lang={lang} />
		<p class="copyright">© {year} {copy.copyright}</p>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: 4rem;
		padding-bottom: 48px;
	}
	.copyright {
		font-family: var(--font-meta);
		font-size: 12px;
		color: var(--ink-soft);
		margin-top: 2.5em;
	}
</style>
