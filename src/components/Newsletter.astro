---
import { t, type Locale, NEWSLETTER_FORM_ENDPOINT } from '../lib/i18n';

interface Props {
	lang: Locale;
	/** Distinguishes this instance's ids from any other Newsletter on the
	 * same page — e.g. a post page renders one at the end of the article
	 * AND gets the site-wide one from Footer. Without this, two instances
	 * would share one iframe `name` (ambiguous submit target) and one
	 * label/input id pair (invalid HTML). */
	instanceId?: string;
}

const { lang, instanceId = 'default' } = Astro.props;
const copy = t(lang).footer;
const inputId = `newsletter-email-${lang}-${instanceId}`;
const iframeName = `ml-target-${lang}-${instanceId}`;
---

<div class="newsletter">
	<p class="eyebrow">{copy.newsletterHeading}</p>
	<p class="body">{copy.newsletterBody}</p>
	<!--
		Plain HTML POST straight to MailerLite (no JS embed, no tracking
		script — the script below is ours, just a form/iframe/message toggle).
		Submits into a hidden iframe so the visitor never leaves the page;
		the script swaps the form for a success message once that iframe
		finishes loading. Since a cross-origin iframe's response body can't be
		read, "finished loading" is the only signal available — this shows
		success on any completed submit, not a confirmed accept from
		MailerLite. Fine for a newsletter signup; a genuinely malformed
		submission is rare given the browser's own email validation.
	-->
	<form class="newsletter-form" action={NEWSLETTER_FORM_ENDPOINT} method="post" target={iframeName}>
		<label for={inputId}>{copy.emailLabel}</label>
		<div class="row">
			<input
				id={inputId}
				type="email"
				name="fields[email]"
				placeholder={copy.emailPlaceholder}
				required
			/>
			<button type="submit">{copy.submitLabel}</button>
		</div>
		<input type="hidden" name="ml-submit" value="1" />
	</form>
	<p class="confirm-note">{copy.newsletterConfirmNote}</p>
	<p class="success-note" hidden aria-live="polite">{copy.newsletterSuccess}</p>
	<iframe name={iframeName} class="ml-target" title="" aria-hidden="true" tabindex="-1"></iframe>
</div>

<script>
	// Runs once per page load and wires up every Newsletter instance present
	// (there can be two: footer + end of post) via closest()/querySelector
	// rather than hardcoded ids, since Astro dedupes this script to a single
	// copy even when the component renders more than once.
	document.querySelectorAll<HTMLFormElement>('.newsletter-form').forEach((form) => {
		const container = form.closest('.newsletter');
		const iframe = container?.querySelector('iframe');
		const successNote = container?.querySelector<HTMLElement>('.success-note');
		const confirmNote = container?.querySelector<HTMLElement>('.confirm-note');
		if (!iframe || !successNote) return;

		form.addEventListener('submit', () => {
			iframe.addEventListener(
				'load',
				() => {
					form.hidden = true;
					if (confirmNote) confirmNote.hidden = true;
					successNote.hidden = false;
				},
				{ once: true }
			);
		});
	});
</script>

<style>
	.newsletter {
		max-width: var(--measure);
	}
	.body {
		color: var(--ink-soft);
	}
	.newsletter-form label {
		display: block;
		font-family: var(--font-meta);
		font-size: 12px;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--ink-soft);
		margin-bottom: 10px;
	}
	.row {
		display: flex;
		gap: 0;
		max-width: 420px;
		flex-wrap: wrap;
	}
	.row input {
		flex: 1;
		min-width: 200px;
		padding: 12px 14px;
		border: 1px solid var(--ink);
		border-right: none;
		background: transparent;
		font-family: var(--font-body);
		font-size: 15px;
		color: var(--ink);
	}
	.row button {
		padding: 12px 20px;
		background: var(--accent);
		color: var(--paper);
		border: 1px solid var(--accent);
		font-family: var(--font-meta);
		font-size: 13px;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		cursor: pointer;
	}
	.row button:hover {
		background: var(--ink);
		border-color: var(--ink);
	}
	@media (max-width: 480px) {
		.row input {
			border-right: 1px solid var(--ink);
		}
	}
	.confirm-note {
		margin-top: 10px;
		max-width: 420px;
		font-family: var(--font-meta);
		font-size: 12px;
		color: var(--ink-soft);
	}
	.success-note {
		max-width: 420px;
		padding: 14px 16px;
		border-left: 2px solid var(--accent);
		font-family: var(--font-body);
		font-size: 15px;
		color: var(--ink);
	}
	.ml-target {
		display: none;
	}
</style>
