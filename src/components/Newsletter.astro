---
import { t, type Locale, NEWSLETTER_FORM_ENDPOINT } from '../lib/i18n';

interface Props {
	lang: Locale;
	/** Distinguishes this instance's label id from any other Newsletter on
	 * the same page — e.g. a post page renders one at the end of the
	 * article AND gets the site-wide one from Footer. Without this both
	 * instances share one <label for>/<input id> pair, which is invalid
	 * HTML (duplicate id) even though it renders fine either way. */
	instanceId?: string;
}

const { lang, instanceId = 'default' } = Astro.props;
const copy = t(lang).footer;
const inputId = `newsletter-email-${lang}-${instanceId}`;
---

<div class="newsletter">
	<p class="eyebrow">{copy.newsletterHeading}</p>
	<p class="body">{copy.newsletterBody}</p>
	<!--
		Plain HTML POST straight to MailerLite (no JS embed, no tracking
		script). target="_blank" is required: this endpoint doesn't redirect
		back to the page it was submitted from, it opens its own confirmation
		page. So after a successful submit the visitor gets a new tab showing
		a plain MailerLite page, not this site — that's expected, not a bug.
	-->
	<form class="newsletter-form" action={NEWSLETTER_FORM_ENDPOINT} method="post" target="_blank">
		<label for={inputId}>{copy.emailLabel}</label>
		<div class="row">
			<input
				id={inputId}
				type="email"
				name="fields[email]"
				placeholder={copy.emailPlaceholder}
				required
			/>
			<button type="submit">{copy.submitLabel}</button>
		</div>
		<input type="hidden" name="ml-submit" value="1" />
	</form>
	<p class="confirm-note">{copy.newsletterConfirmNote}</p>
</div>

<style>
	.newsletter {
		max-width: var(--measure);
	}
	.body {
		color: var(--ink-soft);
	}
	.newsletter-form label {
		display: block;
		font-family: var(--font-meta);
		font-size: 12px;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--ink-soft);
		margin-bottom: 10px;
	}
	.row {
		display: flex;
		gap: 0;
		max-width: 420px;
		flex-wrap: wrap;
	}
	.row input {
		flex: 1;
		min-width: 200px;
		padding: 12px 14px;
		border: 1px solid var(--ink);
		border-right: none;
		background: transparent;
		font-family: var(--font-body);
		font-size: 15px;
		color: var(--ink);
	}
	.row button {
		padding: 12px 20px;
		background: var(--accent);
		color: var(--paper);
		border: 1px solid var(--accent);
		font-family: var(--font-meta);
		font-size: 13px;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		cursor: pointer;
	}
	.row button:hover {
		background: var(--ink);
		border-color: var(--ink);
	}
	@media (max-width: 480px) {
		.row input {
			border-right: 1px solid var(--ink);
		}
	}
	.confirm-note {
		margin-top: 10px;
		max-width: 420px;
		font-family: var(--font-meta);
		font-size: 12px;
		color: var(--ink-soft);
	}
</style>
