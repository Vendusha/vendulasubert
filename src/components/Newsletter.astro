---
import { t, type Locale, NEWSLETTER_FORM_ENDPOINT } from '../lib/i18n';

interface Props {
	lang: Locale;
	/** Distinguishes this instance's ids/iframe name from any other
	 * Newsletter on the same page — e.g. a post page renders one at the end
	 * of the article AND gets the site-wide one from Footer. Without this,
	 * both would render an iframe with the same `name`, which is invalid
	 * HTML and leaves target resolution ambiguous. */
	instanceId?: string;
}

const { lang, instanceId = 'default' } = Astro.props;
const copy = t(lang).footer;
const inputId = `newsletter-email-${lang}-${instanceId}`;
const iframeName = `ml-target-${lang}-${instanceId}`;
---

<div class="newsletter">
	<p class="eyebrow">{copy.newsletterHeading}</p>
	<p class="body">{copy.newsletterBody}</p>
	<!--
		Plain HTML POST straight to MailerLite (no JS embed, no tracking
		script). The form targets a hidden iframe rather than navigating the
		page: MailerLite's endpoint has "jsonp" in its URL because it's meant
		for their own AJAX embed, and a normal top-level POST to it returns a
		bare `{"success":true}` JSON page instead of anything readable. The
		iframe swallows that response invisibly so the visitor just stays on
		this page — the confirm-note paragraph below the form is what tells
		them what happens next, since there's no JS here to pop up a "thanks!"
		message after submit.
	-->
	<form
		class="newsletter-form"
		action={NEWSLETTER_FORM_ENDPOINT}
		method="post"
		target={iframeName}
	>
		<label for={inputId}>{copy.emailLabel}</label>
		<div class="row">
			<input
				id={inputId}
				type="email"
				name="fields[email]"
				placeholder={copy.emailPlaceholder}
				required
			/>
			<button type="submit">{copy.submitLabel}</button>
		</div>
		<input type="hidden" name="ml-submit" value="1" />
	</form>
	<p class="confirm-note">{copy.newsletterConfirmNote}</p>
	<iframe name={iframeName} title="" aria-hidden="true" tabindex="-1" class="ml-target"></iframe>
</div>

<style>
	.newsletter {
		max-width: var(--measure);
	}
	.body {
		color: var(--ink-soft);
	}
	.newsletter-form label {
		display: block;
		font-family: var(--font-meta);
		font-size: 12px;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--ink-soft);
		margin-bottom: 10px;
	}
	.row {
		display: flex;
		gap: 0;
		max-width: 420px;
		flex-wrap: wrap;
	}
	.row input {
		flex: 1;
		min-width: 200px;
		padding: 12px 14px;
		border: 1px solid var(--ink);
		border-right: none;
		background: transparent;
		font-family: var(--font-body);
		font-size: 15px;
		color: var(--ink);
	}
	.row button {
		padding: 12px 20px;
		background: var(--accent);
		color: var(--paper);
		border: 1px solid var(--accent);
		font-family: var(--font-meta);
		font-size: 13px;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		cursor: pointer;
	}
	.row button:hover {
		background: var(--ink);
		border-color: var(--ink);
	}
	@media (max-width: 480px) {
		.row input {
			border-right: 1px solid var(--ink);
		}
	}
	.confirm-note {
		margin-top: 10px;
		max-width: 420px;
		font-family: var(--font-meta);
		font-size: 12px;
		color: var(--ink-soft);
	}
	.ml-target {
		display: none;
	}
</style>
