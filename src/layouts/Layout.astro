---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { siteName, type Locale } from '../lib/i18n';
import '../styles/global.css';

interface Props {
	lang: Locale;
	section: 'home' | 'about' | 'publications' | 'book';
	hasTranslation: boolean;
	title: string;
	description?: string;
}

const { lang, section, hasTranslation, title, description } = Astro.props;
const pageTitle = section === 'home' ? siteName : `${title} — ${siteName}`;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{pageTitle}</title>
		{description && <meta name="description" content={description} />}
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<Header lang={lang} section={section} hasTranslation={hasTranslation} />
		<main class="container">
			<slot />
		</main>
		<Footer lang={lang} />
	</body>
</html>
