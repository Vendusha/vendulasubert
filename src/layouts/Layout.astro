---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { siteName, type Locale } from '../lib/i18n';
import defaultOgImage from '../assets/portrait.jpg';
import '../styles/global.css';

interface Props {
	lang: Locale;
	section: string;
	hasTranslation: boolean;
	toggleHref?: string;
	title: string;
	/** Replaces `title` in <title> and og/twitter titles only — the page's
	 * visible H1 stays `title`. */
	seoTitle?: string;
	description?: string;
	/** Absolute URLs of this page in each language that actually exists.
	 * Only emitted as hreflang when given — never guess a translation. */
	alternates?: { cs?: string; en?: string };
	noindex?: boolean;
	/** Schema.org JSON-LD object(s) for this page. */
	jsonLd?: Record<string, unknown> | Record<string, unknown>[];
	publishedTime?: Date;
	/** Falls back to the site portrait when a page (or post) has no image
	 * of its own — every page should produce a decent social-share card. */
	image?: ImageMetadata;
	ogType?: 'website' | 'article';
}

const {
	lang,
	section,
	hasTranslation,
	toggleHref,
	title,
	seoTitle,
	description,
	alternates,
	noindex = false,
	jsonLd,
	publishedTime,
	image = defaultOgImage,
	ogType = 'website',
} = Astro.props;
const pageTitle = section === 'home' ? siteName : `${seoTitle ?? title} — ${siteName}`;
const jsonLdText = jsonLd
	? JSON.stringify(jsonLd).replace(/</g, '\\u003c')
	: undefined;

// Social platforms expect a 1200x630 preview (Facebook's recommended share
// size), so crop to that rather than shipping the source's own proportions.
const ogImage = await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const absoluteImageUrl = new URL(ogImage.src, Astro.site).toString();
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{pageTitle}</title>
		{description && <meta name="description" content={description} />}
		{noindex && <meta name="robots" content="noindex, follow" />}
		<link rel="canonical" href={Astro.url.href} />
		{
			alternates?.cs && <link rel="alternate" hreflang="cs" href={alternates.cs} />
		}
		{
			alternates?.en && <link rel="alternate" hreflang="en" href={alternates.en} />
		}
		{
			(alternates?.cs || alternates?.en) && (
				<link rel="alternate" hreflang="x-default" href={alternates.cs ?? alternates.en} />
			)
		}
		<link
			rel="alternate"
			type="application/rss+xml"
			title={siteName}
			href={`${import.meta.env.BASE_URL}${lang}/rss.xml`}
		/>

		<meta property="og:type" content={ogType} />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:url" content={Astro.url.href} />
		<meta property="og:image" content={absoluteImageUrl} />
		<meta property="og:locale" content={lang === 'cs' ? 'cs_CZ' : 'en_US'} />
		{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
		{description && <meta property="og:description" content={description} />}

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:image" content={absoluteImageUrl} />
		{description && <meta name="twitter:description" content={description} />}

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		{jsonLdText && <script type="application/ld+json" set:html={jsonLdText} />}
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600&display=swap"
			rel="stylesheet"
		/>

		<!--
			GoatCounter: no cookies, no consent banner needed. Rendered only in
			the production build (import.meta.env.DEV is true under `astro dev`,
			false otherwise) — never while developing locally. The root/old-URL
			redirect stubs (src/components/Redirect.astro) are plain standalone
			HTML documents that don't use this Layout at all, so they're never
			measured either, without needing a separate exclusion here.
			Visitors (and Vendula herself) can opt out for this browser via the
			"Vypnout měření" / "Turn off tracking" link in the footer, which is
			GoatCounter's own built-in #toggle-goatcounter mechanism — see
			https://www.goatcounter.com/help/skip-own-views.
		-->
		{
			!import.meta.env.DEV && (
				<script
					is:inline
					data-goatcounter="https://vendulasubert.goatcounter.com/count"
					async
					src="//gc.zgo.at/count.js"
				/>
			)
		}
	</head>
	<body>
		<Header lang={lang} section={section} hasTranslation={hasTranslation} toggleHref={toggleHref} />
		<main class="container">
			<slot />
		</main>
		<Footer lang={lang} />
	</body>
</html>
