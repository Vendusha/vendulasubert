---
// Sibling of src/pages/cs/hudba/lotr/index.astro — see that file's
// comment for why this is a separate literal route.
import Layout from '../../../../layouts/Layout.astro';
import YouTubeEmbed from '../../../../components/YouTubeEmbed.astro';
import { t } from '../../../../lib/i18n';
import { absUrl } from '../../../../lib/seo';
import {
	PAGE_TITLE,
	CARD_TEXT,
	INTRO,
	HOW_I_MAKE_IT,
	CREDITS,
	CREDITS_LINK_LABEL,
	CREDITS_LINK_URL,
	DISCLAIMER,
	PLAYLIST_URL,
	LOTR_TRACKS,
	trackStatusLabel,
	pick,
} from '../../../../data/lotr';

const lang = 'en' as const;
const musicCopy = t(lang).music;
const copy = t(lang).lotr;
const title = pick(PAGE_TITLE, lang);
const description = pick(CARD_TEXT, lang);
const prologue = LOTR_TRACKS.find((track) => track.youtubeId);
---

<Layout
	lang={lang}
	section="music"
	hasTranslation={true}
	toggleHref={`${import.meta.env.BASE_URL}cs/hudba/lotr/`}
	title={title}
	description={description}
	alternates={{ cs: absUrl('/cs/hudba/lotr/'), en: absUrl('/en/music/lotr/') }}
>
	<article class="prose lotr-page">
		<p class="back-link">
			<a href={`${import.meta.env.BASE_URL}en/music/`}>{copy.backToMusicLabel}</a>
		</p>
		<h1>{title}</h1>
		<p>{pick(INTRO, lang)}</p>

		{
			prologue?.youtubeId && (
				<YouTubeEmbed
					videoId={prologue.youtubeId}
					title={prologue.title}
					playLabel={musicCopy.playLabel}
					thumbnailAlt={musicCopy.thumbnailAlt}
					priority
				/>
			)
		}

		<h2>{copy.howIMakeItHeading}</h2>
		<p>{pick(HOW_I_MAKE_IT, lang)}</p>

		<h2>{copy.tracklistHeading}</h2>
		<ul class="tracklist">
			{
				LOTR_TRACKS.map((track) => (
					<li>
						{track.youtubeId ? (
							<a href={`https://youtu.be/${track.youtubeId}`} target="_blank" rel="noopener noreferrer">
								{track.title}
							</a>
						) : (
							<span>{track.title}</span>
						)}
						{' — '}
						<span class="track-status">{trackStatusLabel(track.status, lang)}</span>
					</li>
				))
			}
		</ul>
		<p class="tracklist-note">{copy.tracklistNote}</p>

		<p>
			<a class="button" href={PLAYLIST_URL} target="_blank" rel="noopener noreferrer">
				{copy.playlistLinkLabel}
			</a>
		</p>

		<h2>{copy.creditsHeading}</h2>
		<p>
			{pick(CREDITS, lang)}{' '}
			<a href={CREDITS_LINK_URL} target="_blank" rel="noopener noreferrer">
				{CREDITS_LINK_LABEL}
			</a>
			.
		</p>
		<p class="disclaimer">{pick(DISCLAIMER, lang)}</p>
	</article>
</Layout>

<style>
	.lotr-page {
		padding-block: 40px 24px;
	}
	.back-link {
		font-family: var(--font-meta);
		font-size: 13px;
	}
	.tracklist {
		padding-left: 1.2em;
	}
	.track-status {
		color: var(--ink-soft);
		font-family: var(--font-meta);
		font-size: 13px;
	}
	.tracklist-note {
		font-family: var(--font-meta);
		font-size: 13px;
		color: var(--ink-soft);
	}
	.disclaimer {
		font-size: 13px;
		color: var(--ink-soft);
	}
</style>
