---
// PHASE 0 PLACEHOLDER PAGE
// This exists only to prove the write -> commit -> push -> live pipeline works.
// It will be replaced in Phase 1 by the real bilingual homepage (/cs/, /en/,
// language toggle, newsletter signup, etc).
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const base = import.meta.env.BASE_URL;
---

<html lang="cs">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>Fáze 0 — testovací index / Phase 0 — test index</title>
	</head>
	<body>
		<h1>Fáze 0: ověření publikačního workflow</h1>
		<p>
			Toto je dočasná stránka, která existuje jen proto, aby ověřila, že
			napsání .md souboru, jeho commit a push skutečně vytvoří živou
			stránku. Skutečný web (čeština/angličtina, newsletter, vzhled) přijde
			ve Fázi 1.
		</p>
		<p>
			<em
				>(EN) This is a throwaway page that only proves the publishing
				pipeline works. The real bilingual site comes in Phase 1.</em
			>
		</p>
		<h2>Články / Posts</h2>
		<ul>
			{
				posts.map((post) => (
					<li>
						<a href={`${base}blog/${post.id}/`}>{post.data.title}</a>
						{' — '}
						{post.data.lang} — {post.data.pubDate.toISOString().slice(0, 10)}
					</li>
				))
			}
		</ul>
	</body>
</html>
