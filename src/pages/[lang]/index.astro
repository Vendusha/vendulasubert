---
import { Picture } from 'astro:assets';
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import TranslationNotice from '../../components/TranslationNotice.astro';
import { loadPage } from '../../lib/pages';
import { t, locales, type Locale } from '../../lib/i18n';
import { COLUMNS } from '../../lib/columns';
import portrait from '../../assets/portrait.jpg';

export function getStaticPaths() {
	return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const { entry, shownLang, hasTranslation } = await loadPage('home', lang);
const { Content } = await render(entry);
const copy = t(lang);
const base = import.meta.env.BASE_URL;
---

<Layout lang={lang} section="home" hasTranslation={hasTranslation} title={entry.data.title} description={entry.data.description}>
	{shownLang !== lang && <TranslationNotice requestedLang={lang} shownLang={shownLang} />}

	<div class="hero">
		<div class="portrait-frame">
			<Picture
				src={portrait}
				alt={lang === 'cs' ? 'Portrét Venduly Šubert' : 'Portrait of Vendula Šubert'}
				width={560}
				widths={[280, 560]}
				sizes="280px"
				formats={['webp']}
				fallbackFormat="jpg"
			/>
		</div>
		<div class="hero-text">
			<h1>{copy.home.heading}</h1>
			<div class="prose">
				<Content />
			</div>
		</div>
	</div>

	<hr class="hairline" />

	<section class="columns">
		<p class="eyebrow">{copy.home.columnsHeading}</p>
		<ul class="columns-list">
			{COLUMNS.map((col) => (
				<li>
					<a
						class:list={['column-card', { quiet: col.quiet }]}
						href={`${base}${lang}/${col.slug}/`}
						style={`--card-accent: ${col.accent}`}
					>
						<Picture
							src={col.heroImage}
							alt=""
							width={560}
							widths={[280, 560]}
							sizes="280px"
							formats={['webp']}
							fallbackFormat="jpg"
							quality={70}
							style={`object-position: ${col.heroPosition ?? 'center'}`}
						/>
						<span class="column-title">{col.title[lang]}</span>
						<p class="column-desc">{col.description[lang]}</p>
					</a>
				</li>
			))}
		</ul>
	</section>

	<hr class="hairline" />

	<section class="closing prose">
		<p>
			{copy.home.bookIntro} <strong>ALEFUJ!</strong>{' '}
			<a href={`${base}${lang}/book/`}>{copy.home.bookLinkLabel} »</a>
		</p>
		<p class="professional-link">
			{copy.home.professionalIntro}{' '}
			<a href={`${base}${lang}/publikace/`}>{copy.home.professionalLinkLabel}</a>.
		</p>
	</section>
</Layout>

<style>
	.hero {
		display: grid;
		grid-template-columns: 280px 1fr;
		gap: 56px;
		align-items: start;
		padding-block: 48px;
	}
	@media (max-width: 720px) {
		.hero {
			grid-template-columns: 1fr;
			gap: 32px;
			padding-block: 24px;
		}
	}
	.portrait-frame {
		border: 1px solid var(--ink);
		padding: 8px;
	}
	.portrait-frame :global(img) {
		display: block;
		width: 100%;
		height: auto;
	}
	.columns {
		padding-block: 8px 40px;
	}
	.columns-list {
		list-style: none;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
		gap: 28px;
		padding: 0;
		margin: 1em 0 0;
	}
	.column-card {
		display: block;
		text-decoration: none;
		color: var(--ink);
	}
	.column-card :global(img) {
		display: block;
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		margin-bottom: 10px;
	}
	.column-card.quiet :global(img) {
		filter: grayscale(40%);
	}
	.column-title {
		display: block;
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 16px;
		margin-bottom: 4px;
	}
	.column-card:hover .column-title {
		color: var(--card-accent);
	}
	.column-desc {
		font-size: 14px;
		color: var(--ink-soft);
		line-height: 1.5;
		margin: 0;
	}
	.closing {
		padding-block: 8px 40px;
	}
	.professional-link {
		color: var(--ink-soft);
		font-size: 15px;
	}
</style>
