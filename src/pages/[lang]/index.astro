---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import TranslationNotice from '../../components/TranslationNotice.astro';
import { loadPage } from '../../lib/pages';
import { t, locales, type Locale } from '../../lib/i18n';
import portrait from '../../assets/portrait.jpg';

export function getStaticPaths() {
	return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const { entry, shownLang, hasTranslation } = await loadPage('home', lang);
const { Content } = await render(entry);
const copy = t(lang);
---

<Layout lang={lang} section="home" hasTranslation={hasTranslation} title={entry.data.title} description={entry.data.description}>
	{shownLang !== lang && <TranslationNotice requestedLang={lang} shownLang={shownLang} />}

	<div class="hero">
		<div class="portrait-frame">
			<Image src={portrait} alt={lang === 'cs' ? 'Portrét Venduly Šubert' : 'Portrait of Vendula Šubert'} widths={[280, 560]} sizes="280px" />
		</div>
		<div class="hero-text">
			<h1>{copy.home.heading}</h1>
			<div class="prose">
				<Content />
			</div>
		</div>
	</div>

	<hr class="hairline" />

	<section class="columns">
		<p class="eyebrow">{copy.home.columnsHeading}</p>
		<p class="columns-note">{copy.home.columnsNote}</p>
		<ul class="columns-list">
			{copy.home.columns.map((name) => (
				<li><span class="tag">{name}</span></li>
			))}
		</ul>
	</section>
</Layout>

<style>
	.hero {
		display: grid;
		grid-template-columns: 280px 1fr;
		gap: 56px;
		align-items: start;
		padding-block: 48px;
	}
	@media (max-width: 720px) {
		.hero {
			grid-template-columns: 1fr;
			gap: 32px;
			padding-block: 24px;
		}
	}
	.portrait-frame {
		border: 1px solid var(--ink);
		padding: 8px;
	}
	.portrait-frame :global(img) {
		display: block;
		width: 100%;
		height: auto;
	}
	.columns {
		padding-block: 8px 40px;
	}
	.columns-note {
		color: var(--ink-soft);
		max-width: var(--measure);
	}
	.columns-list {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		padding: 0;
		margin: 1em 0 0;
	}
</style>
