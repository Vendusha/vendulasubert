---
import { Picture } from 'astro:assets';
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import TranslationNotice from '../../components/TranslationNotice.astro';
import { loadPage } from '../../lib/pages';
import { t, locales, type Locale } from '../../lib/i18n';
import { COLUMNS } from '../../lib/columns';
import portrait from '../../assets/portrait.jpg';

export function getStaticPaths() {
	return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const { entry, shownLang, hasTranslation } = await loadPage('home', lang);
const { Content } = await render(entry);

const oMne = await loadPage('o-mne', lang);
const { Content: OMneContent } = await render(oMne.entry);

const copy = t(lang);
const base = import.meta.env.BASE_URL;
---

<Layout lang={lang} section="home" hasTranslation={hasTranslation} title={entry.data.title} description={entry.data.description}>
	{shownLang !== lang && <TranslationNotice requestedLang={lang} shownLang={shownLang} />}

	<div class="hero" id="ahoj">
		<div class="portrait-frame">
			<Picture
				src={portrait}
				alt={lang === 'cs' ? 'Portrét Venduly Šubert' : 'Portrait of Vendula Šubert'}
				width={560}
				widths={[280, 560]}
				sizes="280px"
				formats={['webp']}
				fallbackFormat="jpg"
			/>
		</div>
		<div class="hero-text">
			<h1>{copy.home.heading}</h1>
			<div class="prose">
				<Content />
			</div>
		</div>
	</div>

	<hr class="hairline" />

	<section class="o-mne prose o-mne-photos" id="o-mne">
		<h2>{oMne.entry.data.title}</h2>
		{oMne.shownLang !== lang && <TranslationNotice requestedLang={lang} shownLang={oMne.shownLang} />}
		<OMneContent />
	</section>

	<hr class="hairline" />

	<section class="columns" id="blog">
		<p class="eyebrow">{copy.home.columnsHeading}</p>
		<ul class="columns-list">
			{COLUMNS.map((col) => (
				<li>
					<a
						class:list={['column-card', { quiet: col.quiet }]}
						href={`${base}${lang}/${col.slug}/`}
						style={`--card-accent: ${col.accent}`}
					>
						<Picture
							src={col.heroImage}
							alt=""
							width={560}
							widths={[280, 560]}
							sizes="280px"
							formats={['webp']}
							fallbackFormat="jpg"
							quality={70}
							style="object-position: top"
						/>
						<span class="column-title">{col.title[lang]}</span>
						<p class="column-desc">{col.description[lang]}</p>
					</a>
				</li>
			))}
		</ul>
	</section>
</Layout>

<style>
	.hero {
		display: grid;
		grid-template-columns: 280px 1fr;
		gap: 56px;
		align-items: start;
		padding-block: 48px;
		scroll-margin-top: 32px;
	}
	@media (max-width: 720px) {
		.hero {
			grid-template-columns: 1fr;
			gap: 32px;
			padding-block: 24px;
		}
	}
	.portrait-frame {
		border: 1px solid var(--ink);
		padding: 8px;
	}
	.portrait-frame :global(img) {
		display: block;
		width: 100%;
		height: auto;
	}
	.o-mne {
		padding-block: 8px 16px;
		scroll-margin-top: 32px;
	}
	.columns {
		padding-block: 8px 40px;
		scroll-margin-top: 32px;
	}
	.columns-list {
		list-style: none;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
		gap: 28px;
		padding: 0;
		margin: 1em 0 0;
	}
	.column-card {
		display: block;
		text-decoration: none;
		color: var(--ink);
	}
	.column-card :global(img) {
		display: block;
		width: 100%;
		/* height:auto looks redundant next to aspect-ratio but isn't: Picture
		   sets literal width/height HTML attributes per image (reflecting
		   each source's own uncropped proportions), and browsers silently
		   use those over aspect-ratio for computing height unless height is
		   *also* explicitly set here — otherwise the three cards render at
		   three different heights instead of a matching 4:3 for all. */
		height: auto;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		margin-bottom: 10px;
	}
	.column-card.quiet :global(img) {
		filter: grayscale(40%);
	}
	.column-title {
		display: block;
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 16px;
		margin-bottom: 4px;
	}
	.column-card:hover .column-title {
		color: var(--card-accent);
	}
	.column-desc {
		font-size: 14px;
		color: var(--ink-soft);
		line-height: 1.5;
		margin: 0;
	}
</style>

<!--
	"Tucked into the page" photos for O mně, moved here from the old
	standalone /o-mne/ route along with the section itself. See that
	component's git history for the original explanation: filename
	matching (not nth-of-type) because inline Markdown images get
	auto-wrapped in their own <p> by the renderer, so they aren't direct
	siblings; is:global + the .o-mne-photos wrapper class because
	<Content /> is a separately-scoped component a normal scoped <style>
	can't reach. Selectors target h3 here (not h2, as on the old page)
	because the section now nests under this page's own "O mně" <h2>.
-->
<style is:global>
	.o-mne-photos h3 {
		clear: both;
	}

	.o-mne-photos p:has(> img[src*='alefuj-cover']),
	.o-mne-photos p:has(> img[src*='beam-monitor-berlin']),
	.o-mne-photos p:has(> img[src*='chanson-koncert']),
	.o-mne-photos p:has(> img[src*='canyoning-alloix']) {
		max-width: 220px;
		margin-top: 0.3em;
		margin-bottom: 1.4em;
	}
	.o-mne-photos p:has(> img[src*='alefuj-cover']),
	.o-mne-photos p:has(> img[src*='chanson-koncert']) {
		float: left;
		margin-right: 28px;
	}
	.o-mne-photos p:has(> img[src*='beam-monitor-berlin']),
	.o-mne-photos p:has(> img[src*='canyoning-alloix']) {
		float: right;
		margin-left: 28px;
	}

	.o-mne-photos p:has(> img[src*='alefuj-cover']) img,
	.o-mne-photos p:has(> img[src*='beam-monitor-berlin']) img,
	.o-mne-photos p:has(> img[src*='chanson-koncert']) img,
	.o-mne-photos p:has(> img[src*='canyoning-alloix']) img {
		display: block;
		width: 100%;
		height: auto;
		border: 8px solid var(--paper);
		outline: 1px solid var(--rule);
		box-shadow: 0 6px 16px rgba(32, 28, 24, 0.18);
		padding: 0;
		margin: 0;
	}
	.o-mne-photos img[src*='alefuj-cover'] {
		transform: rotate(-3deg);
	}
	.o-mne-photos img[src*='beam-monitor-berlin'] {
		transform: rotate(3deg);
	}
	.o-mne-photos img[src*='chanson-koncert'] {
		transform: rotate(-2.5deg);
	}
	.o-mne-photos img[src*='canyoning-alloix'] {
		transform: rotate(3.5deg);
	}

	.o-mne-photos p:has(> img[src*='alefuj-cover']) em,
	.o-mne-photos p:has(> img[src*='beam-monitor-berlin']) em,
	.o-mne-photos p:has(> img[src*='chanson-koncert']) em,
	.o-mne-photos p:has(> img[src*='canyoning-alloix']) em {
		display: block;
		margin-top: 10px;
		font-family: var(--font-body);
		font-style: italic;
		font-size: 13px;
		line-height: 1.4;
		color: var(--ink-soft);
		text-align: center;
	}

	@media (max-width: 720px) {
		.o-mne-photos p:has(> img[src*='alefuj-cover']),
		.o-mne-photos p:has(> img[src*='beam-monitor-berlin']),
		.o-mne-photos p:has(> img[src*='chanson-koncert']),
		.o-mne-photos p:has(> img[src*='canyoning-alloix']) {
			float: none;
			max-width: 100%;
			margin-left: 0;
			margin-right: 0;
		}
		.o-mne-photos img[src*='alefuj-cover'],
		.o-mne-photos img[src*='beam-monitor-berlin'],
		.o-mne-photos img[src*='chanson-koncert'],
		.o-mne-photos img[src*='canyoning-alloix'] {
			transform: none;
		}
	}
</style>
