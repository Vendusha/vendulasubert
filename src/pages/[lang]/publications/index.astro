---
import { render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import TranslationNotice from '../../../components/TranslationNotice.astro';
import { loadPage } from '../../../lib/pages';
import { getPublications, type PubGroup } from '../../../lib/publications';
import { t, locales, type Locale } from '../../../lib/i18n';

export function getStaticPaths() {
	return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const { entry, shownLang, hasTranslation } = await loadPage('publications', lang);
const { Content } = await render(entry);
const copy = t(lang).publications;
const conjunction = lang === 'cs' ? 'a' : 'and';

const publications = getPublications();

const groupOrder: PubGroup[] = ['journal', 'proceedings', 'thesis', 'deliverable'];
const groupLabel: Record<PubGroup, string> = {
	journal: copy.groupJournal,
	proceedings: copy.groupProceedings,
	thesis: copy.groupThesis,
	deliverable: copy.groupDeliverable,
};

// Only these two exact note values are known presentation-type markers in
// the source data; anything else in `note` (e.g. a PMID) is left alone.
function noteBadge(note: string | undefined): string | undefined {
	if (note === 'oral presentation') return copy.presentation;
	if (note === 'poster') return copy.poster;
	return undefined;
}

function linkLabel(type: 'doi' | 'arxiv' | 'url'): string {
	if (type === 'doi') return copy.linkDoi;
	if (type === 'arxiv') return copy.linkArxiv;
	return copy.linkUrl;
}
---

<Layout
	lang={lang}
	section="publications"
	hasTranslation={hasTranslation}
	title={entry.data.title}
	description={entry.data.description}
>
	{shownLang !== lang && <TranslationNotice requestedLang={lang} shownLang={shownLang} />}

	<div class="prose intro">
		<h1>{entry.data.title}</h1>
		<Content />
		<p class="orcid">
			{copy.orcidLabel}: <a href="https://orcid.org/0000-0002-2791-0659">0000-0002-2791-0659</a>
		</p>
	</div>

	<div class="filters" role="group" aria-label={copy.filterAll}>
		<button type="button" class="filter-btn is-active" data-filter="all">{copy.filterAll}</button>
		{groupOrder.map((g) => (
			<button type="button" class="filter-btn" data-filter={g}>{groupLabel[g]}</button>
		))}
	</div>

	{groupOrder.map((group) => {
		const items = publications.filter((p) => p.group === group);
		if (items.length === 0) return null;
		return (
			<section class="pub-group" data-group={group}>
				<h2>{groupLabel[group]}</h2>
				<ul class="pub-list">
					{items.map((pub) => (
						<li class="pub-entry" data-group={group}>
							<p class="pub-title">
								{pub.link ? (
									<a href={pub.link.url}>{pub.title}</a>
								) : (
									pub.title
								)}
								{pub.isFirstAuthor && <span class="badge">{copy.firstAuthorBadge}</span>}
							</p>
							<p class="pub-authors">
								{pub.authors.map((a, i) => (
									<>
										{i > 0 &&
											(i === pub.authors.length - 1 && !a.isEtAl ? ` ${conjunction} ` : ', ')}
										{a.isYou ? <strong class="you">{a.name}</strong> : a.name}
									</>
								))}
							</p>
							<p class="pub-venue">
								{pub.venue && <em>{pub.venue}, </em>}{pub.year}
								{noteBadge(pub.note) && <span class="tag note-tag">{noteBadge(pub.note)}</span>}
								{pub.link && (
									<a class="pub-link" href={pub.link.url}>{linkLabel(pub.link.type)}</a>
								)}
							</p>
							<p class="significance">
								{pub.significance ? (
									pub.significance
								) : (
									<span class="placeholder">[{copy.significancePlaceholder}]</span>
								)}
							</p>
						</li>
					))}
				</ul>
			</section>
		);
	})}
</Layout>

<script>
	const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
	const groups = document.querySelectorAll<HTMLElement>('.pub-group');
	const entries = document.querySelectorAll<HTMLElement>('.pub-entry');

	buttons.forEach((btn) => {
		btn.addEventListener('click', () => {
			const filter = btn.dataset.filter;
			buttons.forEach((b) => b.classList.toggle('is-active', b === btn));

			entries.forEach((entry) => {
				entry.hidden = !(filter === 'all' || entry.dataset.group === filter);
			});
			groups.forEach((group) => {
				const visible = Array.from(group.querySelectorAll<HTMLElement>('.pub-entry')).some(
					(e) => !e.hidden
				);
				group.hidden = !visible;
			});
		});
	});
</script>

<style>
	.intro {
		padding-top: 40px;
	}
	.orcid {
		font-family: var(--font-meta);
		font-size: 14px;
		color: var(--ink-soft);
	}
	.filters {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin: 1em 0 2.5em;
	}
	.filter-btn {
		font-family: var(--font-meta);
		font-size: 12px;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		background: transparent;
		border: 1px solid var(--rule);
		color: var(--ink);
		padding: 8px 14px;
		cursor: pointer;
	}
	.filter-btn:hover {
		border-color: var(--accent);
		color: var(--accent);
	}
	.filter-btn.is-active {
		background: var(--ink);
		border-color: var(--ink);
		color: var(--paper);
	}
	.pub-group {
		margin-bottom: 3em;
	}
	.pub-list {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.pub-entry {
		max-width: var(--measure);
		padding: 20px 0;
		border-top: 1px solid var(--rule);
	}
	.pub-entry:last-child {
		border-bottom: 1px solid var(--rule);
	}
	.pub-title {
		font-family: var(--font-heading);
		font-weight: 600;
		font-size: 18px;
		margin: 0 0 0.4em;
	}
	.badge {
		display: inline-block;
		margin-left: 10px;
		font-family: var(--font-meta);
		font-size: 11px;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--accent);
		border: 1px solid var(--accent);
		padding: 2px 8px;
		vertical-align: middle;
	}
	.pub-authors {
		margin: 0 0 0.3em;
		color: var(--ink-soft);
	}
	.you {
		color: var(--ink);
		font-weight: 600;
	}
	.pub-venue {
		font-family: var(--font-meta);
		font-size: 13px;
		color: var(--ink-soft);
		margin: 0 0 0.5em;
	}
	.note-tag {
		margin-left: 10px;
	}
	.pub-link {
		margin-left: 10px;
		font-family: var(--font-meta);
		text-transform: uppercase;
		font-size: 11px;
		letter-spacing: 0.06em;
	}
	.significance {
		margin: 0;
		font-size: 15px;
	}
	.significance .placeholder {
		color: var(--ink-soft);
		font-style: italic;
	}
</style>
