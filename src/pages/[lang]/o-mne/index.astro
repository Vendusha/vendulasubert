---
// The O mně content now lives inline on the homepage (#o-mne section) —
// this old standalone route just redirects there so nothing that was ever
// linked or bookmarked breaks.
import Redirect from '../../../components/Redirect.astro';
import { locales, type Locale } from '../../../lib/i18n';

export function getStaticPaths() {
	return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
---

<Redirect to={`${lang}/#o-mne`} />
