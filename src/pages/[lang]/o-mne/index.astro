---
import { Picture } from 'astro:assets';
import { render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import TranslationNotice from '../../../components/TranslationNotice.astro';
import { loadPage } from '../../../lib/pages';
import { locales, type Locale } from '../../../lib/i18n';
import portrait from '../../../assets/portrait.jpg';

export function getStaticPaths() {
	return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const { entry, shownLang, hasTranslation } = await loadPage('o-mne', lang);
const { Content } = await render(entry);
---

<Layout
	lang={lang}
	section="o-mne"
	hasTranslation={hasTranslation}
	title={entry.data.title}
	description={entry.data.description}
>
	{shownLang !== lang && <TranslationNotice requestedLang={lang} shownLang={shownLang} />}
	<div class="hero">
		<div class="portrait-frame">
			<Picture
				src={portrait}
				alt={lang === 'cs' ? 'Portrét Venduly Šubert' : 'Portrait of Vendula Šubert'}
				width={560}
				widths={[280, 560]}
				sizes="280px"
				formats={['webp']}
				fallbackFormat="jpg"
			/>
		</div>
		<article class="prose">
			<h1>{entry.data.title}</h1>
			<Content />
		</article>
	</div>
</Layout>

<style>
	.hero {
		display: grid;
		grid-template-columns: 280px 1fr;
		gap: 56px;
		align-items: start;
		padding-block: 40px 24px;
	}
	@media (max-width: 720px) {
		.hero {
			grid-template-columns: 1fr;
			gap: 32px;
		}
	}
	.portrait-frame {
		border: 1px solid var(--ink);
		padding: 8px;
	}
	.portrait-frame :global(img) {
		display: block;
		width: 100%;
		height: auto;
	}
</style>
