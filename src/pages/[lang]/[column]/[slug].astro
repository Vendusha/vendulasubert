---
import { Picture } from 'astro:assets';
import { render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import { getBlogPosts, getRelatedPosts, estimateReadingTime } from '../../../lib/blog';
import { getColumn } from '../../../lib/columns';
import { t, locales, otherLocale, type Locale } from '../../../lib/i18n';

export async function getStaticPaths() {
	const paths = [];
	for (const lang of locales) {
		const posts = await getBlogPosts(lang);
		for (const post of posts) {
			const [column, slug] = post.id.split('/');
			paths.push({ params: { lang, column, slug }, props: { post } });
		}
	}
	return paths;
}

const lang = Astro.params.lang as Locale;
const { post } = Astro.props as { post: Awaited<ReturnType<typeof getBlogPosts>>[number] };
const column = getColumn(post.data.column)!;
const { Content } = await render(post);
const copy = t(lang);
const base = import.meta.env.BASE_URL;

const readingTime = estimateReadingTime(post.body ?? '');
const relatedPosts = await getRelatedPosts(post);
const heroImage = post.data.heroImage ?? column.heroImage;
// A post-specific heroImage doesn't have a hand-picked crop position in the
// frontmatter (most posts don't need one) — "center 30%" is a reasonable
// general-purpose bias toward the upper part of the frame, where the subject
// usually is in a standing full-body outdoor/lab photo. Falls back to the
// column's own tuned position when the post is using the column's default.
const heroPosition = post.data.heroImage ? 'center 30%' : (column.heroPosition ?? 'center');

// The language toggle needs the SPECIFIC sibling post (same translationKey,
// other language), not just the column index — falls back to the column
// index when no translation exists, per the toggle's own contract.
let toggleHref: string;
if (post.data.translationKey) {
	const other = otherLocale(lang);
	const siblings = await getBlogPosts(other);
	const sibling = siblings.find((p) => p.data.translationKey === post.data.translationKey);
	toggleHref = sibling
		? `${base}${other}/${sibling.data.column}/${sibling.id.split('/')[1]}/`
		: `${base}${other}/${post.data.column}/`;
} else {
	toggleHref = `${base}${otherLocale(lang)}/${post.data.column}/`;
}
---

<Layout
	lang={lang}
	section={post.data.column}
	hasTranslation={false}
	toggleHref={toggleHref}
	title={post.data.title}
	description={post.data.summary}
	image={heroImage}
	ogType="article"
>
	<article class:list={['post', { quiet: column.quiet }]}>
		<p class="back-link">
			<a href={`${base}${lang}/${post.data.column}/`} style={`color: ${column.accent}`}
				>{copy.blog.backToColumn} {column.title[lang]}</a
			>
		</p>

		<Picture
			src={heroImage}
			alt=""
			width={1000}
			widths={[600, 1000]}
			sizes="(max-width: 720px) 100vw, 1040px"
			formats={['webp']}
			fallbackFormat="jpg"
			quality={65}
			loading="eager"
			style={`object-position: ${heroPosition}`}
			class="hero-image"
		/>

		<h1>{post.data.title}</h1>
		<p class="meta">
			{copy.blog.publishedOn} {post.data.date.toISOString().slice(0, 10)} · {copy.blog.readingTime(readingTime)}
		</p>

		<div class="prose post-photos">
			<Content />
		</div>
	</article>

	{
		relatedPosts.length > 0 && (
			<section class="related">
				<h2>{copy.blog.relatedHeading}</h2>
				<ul>
					{relatedPosts.map((r) => (
						<li>
							<a href={`${base}${lang}/${r.data.column}/${r.id.split('/')[1]}/`}>{r.data.title}</a>
						</li>
					))}
				</ul>
			</section>
		)
	}
</Layout>

<style>
	.back-link {
		font-family: var(--font-meta);
		font-size: 12px;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		margin-top: 24px;
	}
	.back-link a {
		text-decoration: none;
	}
	.post :global(.hero-image) {
		display: block;
		width: 100%;
		aspect-ratio: 16 / 9;
		object-fit: cover;
		margin: 20px 0 32px;
	}
	.post.quiet :global(.hero-image) {
		max-width: 560px;
		aspect-ratio: 4 / 3;
		filter: grayscale(40%);
	}
	.meta {
		font-family: var(--font-meta);
		font-size: 13px;
		color: var(--ink-soft);
		margin-top: -0.4em;
	}
	.related {
		margin-top: 3em;
		padding-top: 1.5em;
		border-top: 1px solid var(--rule);
		max-width: var(--measure);
	}
	.related ul {
		list-style: none;
		padding: 0;
	}
	.related li {
		margin-bottom: 0.5em;
	}
</style>

<!--
	Generic "tucked into the page" treatment for any post photo written on
	its own line (blank lines before and after — same convention as an
	O mně photo), optionally followed with no blank line by an italic
	caption. Applies automatically to every post, no per-photo CSS needed:
	the selector only matches a <p> whose *only* element children are the
	image and, optionally, the caption <em> — so it can't accidentally
	catch a photo dropped into the middle of a running sentence (that would
	leave real text sharing the paragraph, which this can't detect and
	would look broken if it did match). A photo like that just renders as
	a plain image, same as before.

	Deliberately centred rather than floated like O mně's version: a post
	is long, undivided running prose with no guaranteed heading to clear a
	float against, so an uncleared float here could still be dragging text
	around several paragraphs later. Centring gets the same tilted/framed/
	captioned look without that risk. Rotation cycles through four fixed
	angles by position (not per-filename, since a post's photos aren't a
	fixed known set the way O mně's four are) purely for visual variety.

	Global + .post-photos-scoped for the same reason as O mně's version:
	<Content /> is a separately-scoped component a normal scoped <style>
	here can't reach.
-->
<style is:global>
	.post-photos p:has(> img):not(:has(> :not(img):not(em))) {
		max-width: 420px;
		margin: 1.8em auto;
		text-align: center;
	}
	.post-photos p:has(> img):not(:has(> :not(img):not(em))) img {
		display: block;
		width: 100%;
		height: auto;
		border: 8px solid var(--paper);
		outline: 1px solid var(--rule);
		box-shadow: 0 6px 16px rgba(32, 28, 24, 0.18);
		padding: 0;
		margin: 0 auto;
	}
	.post-photos p:has(> img):not(:has(> :not(img):not(em))):nth-of-type(4n + 1) img {
		transform: rotate(-3deg);
	}
	.post-photos p:has(> img):not(:has(> :not(img):not(em))):nth-of-type(4n + 2) img {
		transform: rotate(2.5deg);
	}
	.post-photos p:has(> img):not(:has(> :not(img):not(em))):nth-of-type(4n + 3) img {
		transform: rotate(-2deg);
	}
	.post-photos p:has(> img):not(:has(> :not(img):not(em))):nth-of-type(4n) img {
		transform: rotate(3deg);
	}
	.post-photos p:has(> img):not(:has(> :not(img):not(em))) em {
		display: block;
		margin-top: 10px;
		font-family: var(--font-body);
		font-style: italic;
		font-size: 13px;
		line-height: 1.4;
		color: var(--ink-soft);
	}
	@media (max-width: 720px) {
		.post-photos p:has(> img):not(:has(> :not(img):not(em))) {
			max-width: 100%;
		}
		.post-photos p:has(> img):not(:has(> :not(img):not(em))) img {
			transform: none;
		}
	}
</style>
