---
import { Picture } from 'astro:assets';
import { render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import TranslationNotice from '../../../components/TranslationNotice.astro';
import { loadPage } from '../../../lib/pages';
import { getColumnPosts, estimateReadingTime } from '../../../lib/blog';
import { COLUMNS } from '../../../lib/columns';
import { t, locales, type Locale } from '../../../lib/i18n';

export function getStaticPaths() {
	return COLUMNS.flatMap((col) => locales.map((lang) => ({ params: { lang, column: col.slug } })));
}

const lang = Astro.params.lang as Locale;
const columnSlug = Astro.params.column as string;
const column = COLUMNS.find((c) => c.slug === columnSlug)!;
// Small header image alternates sides by column position — consistent
// within each page, varying across the three so the section doesn't feel
// mechanically repeated.
const imageRight = COLUMNS.findIndex((c) => c.slug === columnSlug) % 2 === 1;

const { entry, shownLang } = await loadPage(columnSlug, lang);
const { Content } = await render(entry);
const copy = t(lang);
const base = import.meta.env.BASE_URL;

const posts = await getColumnPosts(columnSlug, lang);
const postsWithMeta = posts.map((post) => ({
	post,
	readingTime: estimateReadingTime(post.body ?? ''),
}));
---

<Layout
	lang={lang}
	section={columnSlug}
	hasTranslation={true}
	title={column.title[lang]}
	description={entry.data.description}
	image={column.heroImage}
>
	<div class:list={['column-header', { 'image-right': imageRight, quiet: column.quiet }]}>
		<div class="column-header-image">
			<Picture
				src={column.heroImage}
				alt=""
				width={320}
				widths={[240, 320, 480]}
				sizes="(max-width: 720px) 240px, 320px"
				formats={['webp']}
				fallbackFormat="jpg"
				quality={70}
				loading="eager"
				style={`object-position: ${column.heroPosition ?? 'center'}`}
			/>
		</div>
		<div class="column-header-text">
			<p class="eyebrow">{copy.home.columnsHeading}</p>
			<h1>{column.title[lang]}</h1>

			{shownLang !== lang && <TranslationNotice requestedLang={lang} shownLang={shownLang} />}

			<div class="prose intro">
				<Content />
			</div>
		</div>
	</div>

	{
		postsWithMeta.length === 0 ? (
			<p class="empty">{copy.blog.noPostsYet}</p>
		) : (
			<ul class="post-list">
				{postsWithMeta.map(({ post, readingTime }) => (
					<li class="post-card">
						<a href={`${base}${lang}/${columnSlug}/${post.id.split('/')[1]}/`}>
							<p class="post-date">
								{post.data.date.toISOString().slice(0, 10)} · {copy.blog.readingTime(readingTime)}
							</p>
							<h2>{post.data.title}</h2>
							<p class="post-summary">{post.data.summary}</p>
						</a>
					</li>
				))}
			</ul>
		)
	}
</Layout>

<style define:vars={{ columnAccent: column.accent }}>
	.column-header {
		display: flex;
		flex-direction: column;
		gap: 20px;
		margin: 24px 0 40px;
	}
	.column-header-image {
		max-width: 240px;
	}
	.column-header-image :global(img) {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 4 / 3;
		object-fit: cover;
	}
	.column-header.quiet .column-header-image :global(img) {
		filter: grayscale(40%);
	}
	.column-header-text .eyebrow {
		color: var(--columnAccent);
	}
	.column-header.quiet .column-header-text .eyebrow {
		color: var(--ink-soft);
	}
	@media (min-width: 721px) {
		.column-header {
			flex-direction: row;
			align-items: flex-start;
			gap: 40px;
		}
		.column-header.image-right {
			flex-direction: row-reverse;
		}
		.column-header-image {
			flex: 0 0 30%;
			max-width: 320px;
		}
		.column-header-text {
			flex: 1 1 auto;
			min-width: 0;
		}
	}
	.intro {
		padding-bottom: 8px;
	}
	.empty {
		color: var(--ink-soft);
		font-style: italic;
	}
	.post-list {
		list-style: none;
		padding: 0;
		margin: 2em 0;
	}
	.post-card {
		border-top: 1px solid var(--rule);
		padding: 24px 0;
	}
	.post-card:last-child {
		border-bottom: 1px solid var(--rule);
	}
	.post-card a {
		text-decoration: none;
		color: var(--ink);
		display: block;
	}
	.post-card:hover h2 {
		color: var(--columnAccent);
	}
	.post-date {
		font-family: var(--font-meta);
		font-size: 12px;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--ink-soft);
		margin: 0 0 0.4em;
	}
	.post-card h2 {
		margin: 0 0 0.3em;
		font-size: 22px;
	}
	.post-summary {
		color: var(--ink-soft);
		max-width: var(--measure);
		margin: 0;
	}
</style>
