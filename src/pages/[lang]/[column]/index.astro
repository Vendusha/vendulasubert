---
import { Picture } from 'astro:assets';
import { render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import TranslationNotice from '../../../components/TranslationNotice.astro';
import { loadPage } from '../../../lib/pages';
import { getColumnPosts, estimateReadingTime } from '../../../lib/blog';
import { COLUMNS } from '../../../lib/columns';
import { t, locales, type Locale } from '../../../lib/i18n';

export function getStaticPaths() {
	return COLUMNS.flatMap((col) => locales.map((lang) => ({ params: { lang, column: col.slug } })));
}

const lang = Astro.params.lang as Locale;
const columnSlug = Astro.params.column as string;
const column = COLUMNS.find((c) => c.slug === columnSlug)!;

const { entry, shownLang } = await loadPage(columnSlug, lang);
const { Content } = await render(entry);
const copy = t(lang);
const base = import.meta.env.BASE_URL;

const posts = await getColumnPosts(columnSlug, lang);
const postsWithMeta = posts.map((post) => ({
	post,
	readingTime: estimateReadingTime(post.body ?? ''),
}));
---

<Layout
	lang={lang}
	section={columnSlug}
	hasTranslation={true}
	title={column.title[lang]}
	description={entry.data.description}
	image={column.heroImage}
>
	<div class:list={['column-hero', { quiet: column.quiet }]}>
		<Picture
			src={column.heroImage}
			alt=""
			width={1000}
			widths={[600, 1000]}
			sizes="(max-width: 720px) 100vw, 1040px"
			formats={['webp']}
			fallbackFormat="jpg"
			quality={65}
			loading="eager"
			style={`object-position: ${column.heroPosition ?? 'center'}`}
			class="hero-image"
		/>
		<div class="hero-caption">
			<p class="eyebrow">{copy.home.columnsHeading}</p>
			<h1>{column.title[lang]}</h1>
		</div>
	</div>

	{shownLang !== lang && <TranslationNotice requestedLang={lang} shownLang={shownLang} />}

	<div class="prose intro">
		<Content />
	</div>

	{
		postsWithMeta.length === 0 ? (
			<p class="empty">{copy.blog.noPostsYet}</p>
		) : (
			<ul class="post-list">
				{postsWithMeta.map(({ post, readingTime }) => (
					<li class="post-card">
						<a href={`${base}${lang}/${columnSlug}/${post.id.split('/')[1]}/`}>
							<p class="post-date">
								{post.data.date.toISOString().slice(0, 10)} · {copy.blog.readingTime(readingTime)}
							</p>
							<h2>{post.data.title}</h2>
							<p class="post-summary">{post.data.summary}</p>
						</a>
					</li>
				))}
			</ul>
		)
	}
</Layout>

<style define:vars={{ columnAccent: column.accent }}>
	.column-hero {
		position: relative;
		margin: 24px 0 40px;
	}
	.column-hero :global(.hero-image) {
		display: block;
		width: 100%;
		aspect-ratio: 16 / 9;
		object-fit: cover;
	}
	/* "zivot" is quieter by being smaller and desaturated, not by being
	   cropped into a tighter strip — a severe aspect ratio is exactly what
	   caused the bad face-cropping this is meant to avoid. */
	.column-hero.quiet {
		max-width: 560px;
	}
	.column-hero.quiet :global(.hero-image) {
		aspect-ratio: 4 / 3;
		filter: grayscale(40%);
	}
	.hero-caption {
		padding: 20px 0 0;
	}
	.hero-caption .eyebrow {
		color: var(--columnAccent);
	}
	.column-hero.quiet .hero-caption .eyebrow {
		color: var(--ink-soft);
	}
	.intro {
		padding-bottom: 8px;
	}
	.empty {
		color: var(--ink-soft);
		font-style: italic;
	}
	.post-list {
		list-style: none;
		padding: 0;
		margin: 2em 0;
	}
	.post-card {
		border-top: 1px solid var(--rule);
		padding: 24px 0;
	}
	.post-card:last-child {
		border-bottom: 1px solid var(--rule);
	}
	.post-card a {
		text-decoration: none;
		color: var(--ink);
		display: block;
	}
	.post-card:hover h2 {
		color: var(--columnAccent);
	}
	.post-date {
		font-family: var(--font-meta);
		font-size: 12px;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--ink-soft);
		margin: 0 0 0.4em;
	}
	.post-card h2 {
		margin: 0 0 0.3em;
		font-size: 22px;
	}
	.post-summary {
		color: var(--ink-soft);
		max-width: var(--measure);
		margin: 0;
	}
</style>
